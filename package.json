{
  "name": "dead-zone-outbreak",
  "private": true,
  "version": "0.3.0-dev",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:server": "tsx server/index.ts",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "npm run test:simulation && npm run test:server && npm run test:e2e",
    "test:simulation": "tsx --test src/simulation/*.test.ts",
    "art:reference": "tsx scripts/reference-art.ts && tsx scripts/painted-reference-art.ts",
    "measure:reference": "tsx scripts/measure-reference.ts",
    "record:reference": "node scripts/record-reference.mjs",
    "review:art": "node scripts/art-review.mjs",
    "test:server": "tsx --test server/tests/*.test.ts",
    "test:e2e": "playwright test",
    "test:ui": "playwright test --ui"
  },
  "dependencies": {
    "@colyseus/core": "^0.18.19",
    "@colyseus/schema": "~5.0.40",
    "@colyseus/sdk": "^0.18.5",
    "@colyseus/ws-transport": "^0.18.4",
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^7.1.0"
  }
}
